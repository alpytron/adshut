[Unit]
Description=AdShut template server (template library for TVs, collects their data)
After=network-online.target

[Service]
Environment=PYTHONPATH=%h/adshut/python
EnvironmentFile=-%h/.config/adshut/env
ExecStart=/usr/bin/python3 -u -m adshut.server
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
